# Copy to infra/.env.staging. Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(48))"
DB_OWNER_PASSWORD=change-me
API_JWT_SECRET=change-me-at-least-32-bytes-shared-with-web
INTERNAL_API_KEY=change-me-at-least-16
# python -c "from app.utils.crypto import generate_key;print('k1:'+generate_key())" (run in apps/api)
TOKEN_ENC_KEYS=k1:replace-with-generated-base64-32-bytes
CORS_ORIGINS=https://web-staging.example.com,http://localhost:3000
WEB_URL=https://web-staging.example.com
PUBLIC_API_URL=https://api-staging.example.com
STAGING_DOMAIN=api-staging.example.com
MOCK_AUTH=true
API_PORT=8080
SENTRY_DSN=
REAL_ROUTERS=me,orgs,members,invites,api_keys,notifications,action_cards,autonomy,log,stream,integrations,oauth,field_mapping,ingest,accounts,entity_reviews
