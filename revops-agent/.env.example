# Copy to apps/api/.env. Dev values only; never commit real secrets.
APP_ENV=local                      # local | staging | prod
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/revops          # app role (no BYPASSRLS)
DATABASE_ADMIN_URL=postgresql+asyncpg://admin:admin@localhost:5433/revops  # BYPASSRLS, /admin routes only
DATABASE_MIGRATOR_URL=postgresql+psycopg://owner:owner@localhost:5433/revops  # Alembic only
REDIS_URL=redis://localhost:6379/0
API_JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only-change-me
API_JWT_AUDIENCE=revops-api
TOKEN_ENC_KEYS=k1:MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=   # id:base64(32 bytes); first = active
PUBLIC_API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=notifications@revops.internal
RESEND_API_KEY=
EMAIL_PROVIDER=smtp
MOCK_API=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120          # per user (per IP when unauthenticated)
RATE_LIMIT_SENSITIVE_PER_MINUTE=30 # ingest, oauth, api keys, invites, org creation
MOCK_AUTH=true                     # enforce JWT/roles in mock mode
REAL_ROUTERS=                      # e.g. me,orgs: groups served by real code in mock mode
INTERNAL_API_KEY=dev-internal-key  # X-Internal-Key for /internal/v1 (AI service)
AI_MODE=template                   # template | external (external = apps/ai upgrades explanations/drafts)
AI_SERVICE_URL=                    # apps/ai base URL, e.g. http://localhost:8100 (used when AI_MODE=external)
AI_SERVICE_TIMEOUT_S=10
AI_EXTRACT_WAIT_S=90               # max seconds a manual run waits for signal extraction
FEATURE_EMAIL_SEND=false
SENTRY_DSN=
# Provider credentials (filled when integrations are built)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
