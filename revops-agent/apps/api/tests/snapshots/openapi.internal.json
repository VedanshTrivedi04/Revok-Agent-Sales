 "info": {
  "title": "RevOps Internal AI API",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/v1/orgs/{org}/accounts/{account_id}/contacts": {
   "get": {
    "description": "Contact ids for recipient selection.",
    "operationId": "ai_contacts",
    "parameters": [
     {
      "in": "path",
      "name": "org",
      "required": true,
      "schema": {
       "format": "uuid",
       "title": "Org",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "account_id",
      "required": true,
      "schema": {
       "format": "uuid",
       "title": "Account Id",
       "type": "string"
      }
     },
     {
      "in": "header",
      "name": "x-internal-key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Internal-Key"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/InternalContact"
         },
         "title": "Response Ai Contacts",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Contacts",
    "tags": [
     "AI Internal"
    ]
   }
  },
  "/v1/orgs/{org}/accounts/{account_id}/context": {
   "get": {
    "description": "Everything needed for a run on one finding, including its numbered evidence list.",
    "operationId": "ai_get_context",
    "parameters": [
     {
      "in": "path",
      "name": "org",
      "required": true,
      "schema": {
       "format": "uuid",
       "title": "Org",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "account_id",
      "required": true,
      "schema": {
       "format": "uuid",
       "title": "Account Id",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "finding_id",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "format": "uuid",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Finding Id"
      }
     },
     {
      "in": "header",
      "name": "x-internal-key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Internal-Key"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ContextOut"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Context",
    "tags": [
     "AI Internal"
    ]
   }
  },
  "/v1/orgs/{org}/events/pending-extraction": {
   "get": {
    "description": "Text events matched to an account whose signals_extracted_at is null.",
    "operationId": "ai_pending_events",
    "parameters": [
     {
      "in": "path",
      "name": "org",
      "required": true,
      "schema": {
       "format": "uuid",
       "title": "Org",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 25,
       "maximum": 100,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "account_id",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "format": "uuid",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Account Id"
      }
     },
     {
      "in": "header",
      "name": "x-internal-key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Internal-Key"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PendingExtractionOut"
        }
