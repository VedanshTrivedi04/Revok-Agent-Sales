# Copy to apps/ai/.env. Never commit real secrets.
LLM_BASE_URL=http://localhost:8001/v1      # cloud vLLM URL (e.g. https://xxxx.trycloudflare.com/v1)
LLM_API_KEY=dev-llm-key
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_STRUCTURED_MODE=guided_json            # guided_json | structured_outputs | response_format | none
LLM_ENABLE_THINKING=false                  # Qwen3.5 chat template flag; off for extraction
LLM_SEND_THINKING_FLAG=true                # send chat_template_kwargs.enable_thinking on every call
LLM_TIMEOUT_S=120
INTERNAL_API_URL=http://localhost:8000/internal
INTERNAL_API_KEY=dev-internal-key          # must equal the backend INTERNAL_API_KEY
AI_SERVICE_KEY=                            # X-AI-Key the backend sends; empty = INTERNAL_API_KEY
AI_MAX_CONCURRENT_RUNS=4
AI_WAIT_FOR_APPROVAL=false
CHECKPOINT_DSN=                            # postgres DSN for run checkpoints; empty = in memory
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
